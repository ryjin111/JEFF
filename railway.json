{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": { "startCommand": "node src/server.mjs", "numReplicas": 1,
    "sleepApplication": false, "requiredMountPath": "/data",
    "overlapSeconds": 0, "drainingSeconds": 180,
    "healthcheckPath": "/health", "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 10 }
}
