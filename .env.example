PORT=8788
JEFF_BIND=127.0.0.1
JEFF_PUBLIC_ORIGIN=http://127.0.0.1:8788
JEFF_CHAIN_ID=4663
JEFF_COLLECTION=0xf4127ac7e73a807060cbdd08fc2c776b2e78ce67
JEFF_RPC_URL=https://rpc.mainnet.chain.robinhood.com
JEFF_DATA_ROOT=./data
JEFF_MODEL=bankr/gpt-5.4-mini
JEFF_ALLOWED_MODELS=bankr/gpt-5.4-mini
JEFF_MAX_CONCURRENT_JOBS=2
BANKR_LLM_URL=https://llm.bankr.bot/v1
BANKR_LLM_API_KEY=
# Optional prepaid credits. Configure an explicit, versioned operator tariff
# and record settled funding/grants with scripts/inference-admin.mjs first.
# Charges follow measured tokens at this tariff, not verified Bankr debits.
JEFF_INFERENCE_CREDITS_ENABLED=false
JEFF_MAX_JOB_CHARGE_MICROS=100000
JEFF_INFERENCE_PRICING={}
JEFF_PILOT_NFTS=35
JEFF_PILOT_EXPIRES_AT=
JEFF_CONTINUOUS_HOSTING=false
JEFF_PAID_CHECKOUT_ENABLED=false
JEFF_FREE_PASS_ENABLED=false
# One server-issued 30-day/100-task pass per NFT; no on-chain item is minted or burned.
# Keep disabled after disaster recovery until post-backup spent records are reconciled.
CLOCKERS_TOKEN_ADDRESS=0xefc067e5d19b847da7863f3f997c2a4639686ba3
# $10 USD per 30 days, converted by the server into a 15-minute CLOCKERS quote.
# Includes 100 tasks per paid period. Complete holder/payment checks before enabling checkout.
CLOCKERS_PAYMENT_RECIPIENT=0x2a9Bc20B7e7638808019A9A1B5Ee5EB6132DBff2
# Optional recurring encrypted backup. Leave unset until the recipient private
# key is retained independently and the S3/R2 destination is verified.
# JEFF_RECURRING_BACKUP={"publicKey":"RSA public PEM","endpoint":"https://S3_ENDPOINT","bucket":"BUCKET","region":"auto","prefix":"jeff","intervalHours":24}
JEFF_BACKUP_ACCESS_KEY_ID=
JEFF_BACKUP_SECRET_ACCESS_KEY=
# Separate monitor-service settings, not needed by the JEFF app.
JEFF_ALERT_WEBHOOK=
JEFF_ALERT_BEARER=
