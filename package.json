  "exports": {
    ".": "./api/_lib/jeff-agent-nft-promoted.mjs",
    "./brain": "./api/_lib/jeff-brain-v1.mjs",
    "./brain-memory": "./api/_lib/jeff-authorized-memory.mjs",
    "./mcp-context": "./api/_lib/jeff-mcp-context.mjs",
    "./learning": "./api/_lib/jeff-learning-feedback.mjs",
    "./open-weights": "./api/_lib/jeff-open-weights-provider.mjs",
    "./contract": "./api/_lib/jeff-agent-nft-contract.mjs",
    "./capabilities": "./api/_lib/jeff-agent-nft-capabilities.mjs",
    "./review": "./api/_lib/jeff-review.mjs",
    "./memory": "./api/_lib/jeff-memory-layer.mjs",
    "./soak": "./api/_lib/jeff-live-shadow-soak.mjs",
    "./benchmark": "./api/_lib/jeff-benchmark-v2.mjs"
  },
  "files": [
    "api/",
    "models/",
    "datasets/",
    "benchmarks/",
    "docs/",
    "examples/",
    "public/",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ]
}
