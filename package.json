    "benchmark:v7:verify-score": "node scripts/score-jeff-v7-blind.mjs --verify",
    "benchmark:v6:freeze": "node scripts/run-jeff-v6-blind.mjs",
    "benchmark:v6:verify-freeze": "node scripts/run-jeff-v6-blind.mjs --verify",
    "benchmark:v6:score": "node scripts/score-jeff-v6-blind.mjs",
    "benchmark:v6:verify-score": "node scripts/score-jeff-v6-blind.mjs --verify",
    "remediation:v0.9:build": "node scripts/build-jeff-v0.9-remediation.mjs",
    "remediation:v0.9:evaluate": "node scripts/evaluate-jeff-v0.9-remediation.mjs",
    "remediation:v0.9:verify": "node scripts/build-jeff-v0.9-remediation.mjs --verify && node scripts/evaluate-jeff-v0.9-remediation.mjs --verify",
