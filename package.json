    "benchmark:v5:verify-score": "node scripts/score-jeff-v5-blind.mjs --verify",
    "remediation:v0.8:build": "node scripts/build-jeff-v0.8-remediation.mjs",
    "remediation:v0.8:evaluate": "node scripts/evaluate-jeff-v0.8-remediation.mjs",
    "remediation:v0.8:verify": "node scripts/build-jeff-v0.8-remediation.mjs --verify && node scripts/evaluate-jeff-v0.8-remediation.mjs --verify",
    "benchmark:v4:freeze": "node scripts/run-jeff-v4-blind.mjs",
    "benchmark:v4:verify-freeze": "node scripts/run-jeff-v4-blind.mjs --verify",
    "benchmark:v4:score": "node scripts/score-jeff-v4-blind.mjs",
    "benchmark:v4:verify-score": "node scripts/score-jeff-v4-blind.mjs --verify",
    "remediation:v0.7:build": "node scripts/build-jeff-v0.7-remediation.mjs",
    "remediation:v0.7:evaluate": "node scripts/evaluate-jeff-v0.7-remediation.mjs",
    "remediation:v0.7:verify": "node scripts/build-jeff-v0.7-remediation.mjs --verify && node scripts/evaluate-jeff-v0.7-remediation.mjs --verify",
    "remediation:build": "node scripts/build-jeff-v0.6-remediation.mjs",
    "remediation:verify": "node scripts/build-jeff-v0.6-remediation.mjs --verify && node scripts/evaluate-jeff-v0.6-remediation.mjs --verify && node scripts/evaluate-jeff-v0.6-regression.mjs --verify",
    "remediation:regression": "node scripts/evaluate-jeff-v0.6-regression.mjs",
    "benchmark:v2:remediation": "node scripts/evaluate-jeff-v0.6-remediation.mjs",
    "benchmark:v2:verify-remediation": "node scripts/evaluate-jeff-v0.6-remediation.mjs --verify",
    "benchmark:v3:build": "node scripts/build-jeff-v3-blind-stimuli.mjs",
    "benchmark:v3:freeze": "node scripts/run-jeff-v3-blind.mjs",
    "benchmark:v3:score": "node scripts/score-jeff-v3-blind.mjs",
    "benchmark:v3:verify-score": "node scripts/score-jeff-v3-blind.mjs --verify",
