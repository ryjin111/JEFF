{
  "name": "jeff-agent-nft",
  "version": "0.5.0",
  "description": "Open, token-agnostic shadow decision model and benchmark for Agent NFTs.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "remediation:build": "node scripts/build-jeff-v0.6-remediation.mjs",
    "remediation:verify": "node scripts/build-jeff-v0.6-remediation.mjs --verify && node scripts/evaluate-jeff-v0.6-remediation.mjs --verify && node scripts/evaluate-jeff-v0.6-regression.mjs --verify",
    "remediation:regression": "node scripts/evaluate-jeff-v0.6-regression.mjs",
    "benchmark:v2:remediation": "node scripts/evaluate-jeff-v0.6-remediation.mjs",
    "benchmark:v2:verify-remediation": "node scripts/evaluate-jeff-v0.6-remediation.mjs --verify",
    "benchmark:v2:build": "node scripts/build-jeff-v2-reliability-stimuli.mjs",
    "benchmark:v2:freeze": "node scripts/run-jeff-v2-reliability.mjs",
    "benchmark:v2:score": "node scripts/score-jeff-v2-reliability.mjs",
    "benchmark:v2:verify-score": "node scripts/score-jeff-v2-reliability.mjs --verify",
    "benchmark:v2:verify-freeze": "node scripts/build-jeff-v2-reliability-stimuli.mjs --verify && node scripts/run-jeff-v2-reliability.mjs --verify",
    "demo": "node examples/infer.mjs",
    "review": "node examples/review.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "node scripts/verify-release.mjs && npm test"
  },
  "exports": {
    ".": "./api/_lib/jeff-agent-nft-promoted.mjs",
    "./contract": "./api/_lib/jeff-agent-nft-contract.mjs",
    "./capabilities": "./api/_lib/jeff-agent-nft-capabilities.mjs",
    "./review": "./api/_lib/jeff-review.mjs",
    "./benchmark": "./api/_lib/jeff-benchmark-v2.mjs"
  },
  "files": [
    "api/",
    "models/",
    "datasets/",
    "benchmarks/",
    "docs/",
    "examples/",
    "public/",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ]
}
